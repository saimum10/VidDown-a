    <string name="about_build">Build</string>
    <string name="about_none">none</string>
    <string name="about_build_details">Native tools: %1$s\nPackaged ABIs: %2$s\nCPython %3$s, yt-dlp %4$s, FFmpeg %5$s</string>
    <string name="about_newpipe_version">NewPipeExtractor %1$s (%2$s): the newest release when this build was made</string>
    <string name="about_build_note">These are the versions packaged in this build. They are not a promise that every component works on every device.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_text">VidDown has no analytics and no tracking. Downloads, library, history and settings stay on your device. It asks only for what downloading needs: internet access, knowing whether you are on Wi-Fi, a notification while downloads run, and (if you allow it) notifications when they finish. It contacts only the addresses you open or download from.</string>
    <string name="about_source">Source code</string>
    <string name="about_source_unset">No source repository link is set in this build.</string>
    <string name="about_licenses">Third-party licenses</string>
    <string name="about_licenses_open">View third-party licenses</string>
    <string name="about_thanks">Acknowledgements</string>
    <string name="about_thanks_text">VidDown builds on open-source work: yt-dlp, FFmpeg, CPython and OpenSSL are bundled with it, and the open design of NewPipe inspired how extraction is separated from the rest of the app. Thank you to everyone who maintains these projects.</string>
