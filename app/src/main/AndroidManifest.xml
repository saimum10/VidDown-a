<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The downloader/browser need the network; the yt-dlp child process inherits this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi-only downloads and "waiting for network" need to know what kind of network is active. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Downloads run in a foreground service so they continue with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Completed/failed notifications (Android 13+). Downloads work without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving to VidDown in the root of the main storage (/storage/emulated/0/VidDown). Without it downloads go to Download/VidDown. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".VidDownApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.VidDown">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share menu: a link shared as text opens in the in-app browser. VidDown does not register as a handler of all
                 web links (no VIEW filter for http/https): it is a downloader, not a default browser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".RuntimeCheckActivity"
            android:exported="false"
            android:label="@string/settings_runtime_check"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    </application>

</manifest>
